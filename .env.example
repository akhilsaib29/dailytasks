# Telegram: @BotFather → /newbot
TELEGRAM_TOKEN=
# Any long random string you make up (protects the webhook)
TELEGRAM_SECRET=
# Your chat id — send /start to the bot to get it
ALLOWED_CHAT_ID=

# Groq: console.groq.com → API Keys
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase: Project Settings → API (use the service_role key, never share it)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Password for the dashboard page (make one up)
DASHBOARD_KEY=

# Language for task titles/descriptions. Voice can be any language.
OUTPUT_LANGUAGE=English

# Zoho Projects (India DC). Self Client at https://api-console.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Get it once from /api/zoho/connect?key=<DASHBOARD_KEY>&code=<grant code>
ZOHO_REFRESH_TOKEN=
ZOHO_PORTAL_ID=
ZOHO_PROJECT_ID=
# Your Zoho Projects user (zpuid): new tasks are assigned to it
ZOHO_OWNER_ZPUID=
